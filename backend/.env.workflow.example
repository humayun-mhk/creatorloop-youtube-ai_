# CreatorLoop backend -> n8n
N8N_CHANNEL_SYNC_WEBHOOK_URL=https://YOUR-N8N-DOMAIN/webhook/creatorloop-channel-sync
N8N_CHANNEL_SYNC_WEBHOOK_SECRET=replace-with-a-long-random-secret
N8N_CHANNEL_SYNC_WEBHOOK_SECRET_HEADER=X-Internal-API-Key
N8N_CHANNEL_SYNC_TIMEOUT_SECONDS=30

# FastAPI internal API key.
# Configure the n8n "FastAPI - Ingest + Gemini Analyze" Header Auth credential
# to send this exact value in X-Internal-API-Key.
INTERNAL_API_KEY=replace-with-a-different-long-random-secret

# Approved reply -> separate n8n publishing workflow
N8N_REPLY_WEBHOOK_URL=https://YOUR-N8N-DOMAIN/webhook/youtube-reply
N8N_REPLY_WEBHOOK_SECRET=replace-with-a-long-random-secret
N8N_REPLY_WEBHOOK_SECRET_HEADER=X-Internal-API-Key
N8N_REPLY_TIMEOUT_SECONDS=20

# Gemini classification + reply generation
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
COMMENT_REPLY_POLICY=Reply when the viewer asks a useful question, requests content, reports a meaningful problem, or gives feedback that benefits from a response. Do not reply to spam, promotion, abusive noise, emoji-only comments, or generic praise that needs no answer.

# Existing CreatorLoop settings (examples; retain your production values)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CREATORLOOP_DEBUG=false
SEMANTIC_MATCH_THRESHOLD=0.78
SEMANTIC_SEARCH_TOP_K=5
CREATOR_REPLY_STYLE=Friendly, concise, helpful, and conversational
REPLY_MAX_CHARACTERS=500
CORS_ORIGINS=["http://localhost:3000"]
