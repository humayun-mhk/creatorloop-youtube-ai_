          "id": "gpZeh99h9QdKazzr",
          "name": "N8N_QUICK_ANALYZE"
        }
      },
      "webhookId": "creatorloop-youtube-reply"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst youtubeCommentId = String(body.youtube_comment_id ?? '').trim();\nconst reply = String(body.reply ?? '').trim();\nif (!youtubeCommentId) throw new Error('youtube_comment_id is required');\nif (!reply) throw new Error('reply is required');\nif (reply.length > 2000) throw new Error('reply is too long');\nreturn [{ json: {\n  youtube_comment_id: youtubeCommentId,\n  reply,\n  idempotency_key: $json.headers?.['idempotency-key'] ?? youtubeCommentId\n} }];"
      },
      "id": "1b729b47-bb9c-4132-94ad-552efbe60bd4",
      "name": "Validate Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        192
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/channels",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "snippet"
            },
            {
              "name": "mine",
              "value": "true"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "3edf16b2-e70f-4387-a232-21f3f9880f59",
      "name": "YouTube - Publishing Account",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        416,
        192
      ],
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "N8J7AdfIC0ZRramJ",
          "name": "YouTube account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const publisher = $json.items?.[0];\nif (!publisher?.id) throw new Error('The connected Google account does not have an authenticated YouTube channel');\nconst req = $('Validate Reply').first().json;\nreturn [{ json: {\n  ...req,\n  publisher_channel_id: publisher.id,\n  publisher_channel_title: publisher.snippet?.title ?? 'YouTube channel'\n} }];"
      },
      "id": "f3ad17d9-8aec-464a-9902-99def8331b70",
      "name": "Validate Publishing Account",
      "type": "n8n-nodes-base.code",
