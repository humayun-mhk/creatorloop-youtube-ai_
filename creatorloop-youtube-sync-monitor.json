    {
      "parameters": {
        "jsCode": "const item = $json.items?.[0];\nif (!item?.id) throw new Error('Public YouTube channel not found');\nconst s = item.snippet ?? {};\nconst c = item.contentDetails ?? {};\nconst st = item.statistics ?? {};\nconst brand = item.brandingSettings?.channel ?? {};\nconst status = item.status ?? {};\nconst topics = item.topicDetails ?? {};\nconst thumbnail = s.thumbnails?.high?.url ?? s.thumbnails?.medium?.url ?? s.thumbnails?.default?.url ?? null;\nreturn [{ json: {\n  youtube_channel_id: item.id,\n  channel_title: s.title || 'YouTube Channel',\n  channel_url: `https://www.youtube.com/channel/${item.id}`,\n  custom_url: s.customUrl ?? null,\n  thumbnail_url: thumbnail,\n  description: s.description ?? '',\n  country: s.country ?? brand.country ?? null,\n  default_language: s.defaultLanguage ?? brand.defaultLanguage ?? null,\n  published_at: s.publishedAt ?? null,\n  uploads_playlist_id: c.relatedPlaylists?.uploads ?? null,\n  subscriber_count: Number(st.subscriberCount ?? 0),\n  hidden_subscriber_count: Boolean(st.hiddenSubscriberCount ?? false),\n  channel_view_count: Number(st.viewCount ?? 0),\n  public_video_count: Number(st.videoCount ?? 0),\n  keywords: brand.keywords ?? null,\n  topic_categories: topics.topicCategories ?? [],\n  privacy_status: status.privacyStatus ?? null,\n  made_for_kids: status.madeForKids ?? null\n} }];"
      },
