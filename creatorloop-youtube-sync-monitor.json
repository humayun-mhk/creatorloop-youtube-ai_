      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst allowed = ['connect', 'sync'];\nif (!allowed.includes(body.action)) throw new Error('action must be connect or sync');\nif (!body.callback_base_url) throw new Error('callback_base_url is required');\n\nconst callback = String(body.callback_base_url).replace(/\\/$/, '');\nif (body.action === 'connect' && !body.target_channel) throw new Error('target_channel is required for connect');\nif (body.action === 'sync') {\n  if (!body.channel_id) throw new Error('channel_id is required for sync');\n  if (!body.youtube_channel_id) throw new Error('youtube_channel_id is required for sync');\n}\n\n// Used only by the schedule trigger to know which CreatorLoop backend to call.\nconst state = $getWorkflowStaticData('global');\nstate.callback_base_url = callback;\nif (body.channel_id) state.channel_id = Number(body.channel_id);\nif (body.youtube_channel_id) state.youtube_channel_id = String(body.youtube_channel_id);\n\nreturn [{ json: { ...body, callback_base_url: callback } }];"
      },
