        "jsCode": "const req = $('Validate FastAPI Request').first().json;\nconst item = $json.items?.[0];\nif (!item?.id) throw new Error('YouTube channel no longer exists or is not public');\nconst uploads = item.contentDetails?.relatedPlaylists?.uploads;\nif (!uploads) throw new Error('Channel uploads playlist was not returned by YouTube');\nconst state = $getWorkflowStaticData('global');\nstate.callback_base_url = req.callback_base_url;\nstate.channel_id = Number(req.channel_id);\nstate.youtube_channel_id = item.id;\nstate.uploads_playlist_id = uploads;\nreturn [{ json: {\n  callback_base_url: req.callback_base_url,\n  channel_id: Number(req.channel_id),\n  youtube_channel_id: item.id,\n  uploads_playlist_id: uploads,\n  video_sync_mode: 'all'\n} }];"
