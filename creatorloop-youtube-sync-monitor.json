    {
      "parameters": {
        "jsCode": "function getContext() {\n  try {\n    const m = $('Build Monitor Context').first().json;\n    if (m?.video_sync_mode === 'recent') return m;\n  } catch {}\n  return $('Build Full Sync Context').first().json;\n}\nconst ctx = getContext();\nconst ids = [];\nfor (const input of items) {\n  const body = input.json.body ?? input.json;\n  for (const row of body.items ?? []) {\n    const id = row.contentDetails?.videoId;\n    if (id && !ids.includes(id)) ids.push(id);\n  }\n}\nif (!ids.length) return [{ json: { ...ctx, __no_videos: true } }];\nconst output = [];\nfor (let i = 0; i < ids.length; i += 50) {\n  output.push({ json: { ...ctx, __no_videos: false, video_ids: ids.slice(i, i + 50) } });\n}\nreturn output;"
      },
