    {
      "parameters": {
        "jsCode": "const ctx = $('Prepare Comment Poll').first().json;\nconst output = [];\nfor (const input of items) {\n  const body = input.json.body ?? input.json;\n  for (const thread of body.items ?? []) {\n    const top = thread.snippet?.topLevelComment;\n    const s = top?.snippet;\n    if (!top?.id || !s?.videoId || !s?.textOriginal && !s?.textDisplay) continue;\n    output.push({ json: {\n      event_type: 'youtube.comment.received',\n      source: 'youtube',\n      monitored_channel_id: ctx.youtube_channel_id,\n      comment: {\n        youtube_comment_id: top.id,\n        youtube_thread_id: thread.id,\n        video_id: s.videoId,\n        author_name: s.authorDisplayName || 'YouTube viewer',\n        author_channel_id: s.authorChannelId?.value ?? null,\n        author_profile_image_url: s.authorProfileImageUrl ?? null,\n        author_channel_url: s.authorChannelUrl ?? null,\n        text: s.textOriginal ?? s.textDisplay ?? '',\n        like_count: Number(s.likeCount ?? 0),\n        reply_count: Number(thread.snippet?.totalReplyCount ?? 0),\n        can_reply: thread.snippet?.canReply !== false,\n        is_public: thread.snippet?.isPublic !== false,\n        published_at: s.publishedAt,\n        updated_at: s.updatedAt ?? s.publishedAt\n      },\n      video: { found: false, video_id: s.videoId },\n      ingestion: {\n        fetched_at: new Date().toISOString(),\n        pipeline: 'creatorloop-n8n-youtube-monitor-v3'\n      }\n    } });\n  }\n}\nif (!output.length) return [{ json: { ...ctx, __no_comments: true } }];\nreturn output;"
      },
