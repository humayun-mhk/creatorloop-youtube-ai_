    {
      "parameters": {
        "jsCode": "const raw = String($json.target_channel || '').trim();\nif (!raw) throw new Error('target_channel is empty');\nlet value = raw;\ntry {\n  const u = new URL(raw);\n  if (!u.hostname.toLowerCase().includes('youtube.com')) throw new Error('Only YouTube channel URLs are supported');\n  const parts = u.pathname.split('/').filter(Boolean);\n  if (parts[0] === 'channel' && parts[1]) value = parts[1];\n  else if (parts[0]?.startsWith('@')) value = parts[0];\n  else value = parts[0] || raw;\n} catch (e) {\n  if (/^https?:\\/\\//i.test(raw)) throw e;\n}\nvalue = String(value).trim();\nlet lookup_type = 'search';\nlet lookup_value = value;\nif (/^UC[0-9A-Za-z_-]{20,}$/.test(value)) lookup_type = 'id';\nelse if (value.startsWith('@')) { lookup_type = 'handle'; lookup_value = value; }\nelse if (/^[A-Za-z0-9._-]+$/.test(value)) { lookup_type = 'handle'; lookup_value = '@' + value.replace(/^@/, ''); }\nreturn [{ json: { ...$json, lookup_type, lookup_value } }];"
      },
