        "jsCode": "const ctx = $('Prepare Comment Poll').first().json;\nlet delivered = 0;\nlet suggested = 0;\nlet unmet = 0;\nfor (const input of items) {\n  const body = input.json.body ?? input.json;\n  if (body.__no_comments) continue;\n  delivered += 1;\n  if (body.outcome === 'reply_suggested') suggested += 1;\n  if (body.outcome === 'unmet_demand') unmet += 1;\n}\nreturn [{ json: { ...ctx, comments_delivered: delivered, replies_suggested: suggested, unmet_demand: unmet } }];"
      },
