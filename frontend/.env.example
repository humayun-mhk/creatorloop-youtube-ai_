# FastAPI deployment. This URL is safe to expose, but browser code in this
# frontend talks to the Next.js server proxy instead of calling it directly.
NEXT_PUBLIC_API_BASE_URL=https://creatorloop-youtube-ai-1.onrender.com

# SERVER ONLY. Never prefix this with NEXT_PUBLIC_.
# Must match FastAPI INTERNAL_API_KEY.
FASTAPI_INTERNAL_API_KEY=replace-with-the-same-secret-used-on-render
